:root {
    --boot-blue-950: #052c65;
    --boot-blue-900: #073b8c;
    --boot-blue-800: #084298;
    --boot-blue-700: #0a58ca;
    --boot-blue-600: #0d6efd;
    --boot-blue-500: #2584ff;
    --boot-blue-100: #dcecff;
    --boot-blue-050: #f4f9ff;
    --boot-ink: #172033;
}

body {
    color: var(--boot-ink);
    background: #f7faff;
    min-height: 100vh;
}

.boot-navbar {
    background: linear-gradient(100deg, var(--boot-blue-950), var(--boot-blue-700) 60%, var(--boot-blue-500));
    box-shadow: 0 8px 24px rgba(5, 44, 101, .18);
}

.boot-navbar .navbar-brand { font-weight: 800; letter-spacing: .2px; }
.boot-navbar .nav-link { color: rgba(255,255,255,.9); font-weight: 600; }
.boot-navbar .nav-link:hover, .boot-navbar .nav-link:focus { color: #fff; }

.hero-panel {
    border: 0;
    border-radius: 1.4rem;
    overflow: hidden;
    background:
        radial-gradient(circle at 90% 10%, rgba(255,255,255,.25), transparent 26%),
        linear-gradient(120deg, var(--boot-blue-950), var(--boot-blue-600));
    color: white;
    box-shadow: 0 18px 50px rgba(13,110,253,.20);
}

.soft-card {
    border: 1px solid #dbe9fb;
    border-radius: 1rem;
    background: white;
    box-shadow: 0 8px 24px rgba(31, 78, 121, .06);
}

.section-kicker {
    color: var(--boot-blue-700);
    font-size: .78rem;
    letter-spacing: .09em;
    font-weight: 800;
    text-transform: uppercase;
}

.stat-number { font-size: 2rem; font-weight: 800; color: var(--boot-blue-800); }

.lesson-number {
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--boot-blue-100);
    color: var(--boot-blue-900);
    font-weight: 800;
    flex: 0 0 auto;
}

.video-stage {
    min-height: 280px;
    border-radius: 1.2rem;
    background: linear-gradient(140deg, #071c3b, #0a58ca);
    color: white;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.1);
}

.video-play {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,.16);
    border: 1px solid rgba(255,255,255,.35);
    font-size: 1.8rem;
    margin-bottom: 1rem;
}

.code-panel {
    background: #081a2f;
    color: #e6f1ff;
    border-radius: .9rem;
    padding: 1rem 1.1rem;
    overflow-x: auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: .88rem;
    white-space: pre-wrap;
}

.boot-footer {
    border-top: 1px solid #dbe9fb;
    background: white;
    color: #5f6b7a;
}

.badge-role { background: var(--boot-blue-100); color: var(--boot-blue-900); }

/* Bootstrap does not provide multi-level dropdowns natively. This small layer supports course nesting. */
.dropdown-submenu { position: relative; }
.dropdown-submenu > .dropdown-menu {
    top: -.5rem;
    left: 100%;
    margin-left: .15rem;
    min-width: 310px;
    max-height: 70vh;
    overflow-y: auto;
}
.dropdown-submenu > .dropdown-item::after {
    content: "›";
    float: right;
    font-size: 1.2rem;
    line-height: 1rem;
    margin-left: 1rem;
}

@media (min-width: 992px) {
    .dropdown-submenu:hover > .dropdown-menu { display: block; }
}

@media (max-width: 991.98px) {
    .dropdown-submenu > .dropdown-menu {
        position: static;
        margin: .25rem .75rem .5rem;
        border-left: 3px solid var(--boot-blue-100);
        box-shadow: none;
        max-height: none;
    }
}

/* Rich LMS lesson pages */
html { scroll-behavior: smooth; }
.lesson-hero {
    border-radius: 1.35rem;
    color: #fff;
    background: radial-gradient(circle at 88% 10%, rgba(255,255,255,.22), transparent 25%), linear-gradient(120deg, #052c65, #0a58ca 65%, #2584ff);
    box-shadow: 0 18px 45px rgba(13,110,253,.16);
}
.lesson-chip { padding: .38rem .7rem; border-radius: 999px; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.24); font-size: .72rem; font-weight: 800; letter-spacing: .06em; }
.lesson-hero-callout { border-radius: 1rem; padding: 1.25rem; background: rgba(2,25,60,.25); border: 1px solid rgba(255,255,255,.2); }
.lesson-section { scroll-margin-top: 90px; }
.objective-item { display: flex; gap: .85rem; height: 100%; padding: 1rem; border: 1px solid #e0ebf8; border-radius: .9rem; background: #fbfdff; }
.objective-item > span, .timeline-item > span, .lab-step > span { width: 2rem; height: 2rem; flex: 0 0 2rem; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--boot-blue-100); color: var(--boot-blue-900); font-weight: 800; }
.objective-item small, .recap-item small { display: block; color: #657184; margin-top: .2rem; }
.scenario-box { border-left: 5px solid var(--boot-blue-600); border-radius: .8rem; padding: 1.35rem 1.5rem; background: var(--boot-blue-050); }
.scenario-label { color: var(--boot-blue-700); font-size: .72rem; letter-spacing: .09em; font-weight: 800; margin-bottom: .45rem; }
.mini-card { border: 1px solid #dbe9fb; border-radius: .9rem; padding: 1rem; background: #fff; }
.mini-card p, .myth-card p { color: #667285; font-size: .9rem; margin: .4rem 0 0; }
.lesson-insight { padding: 1rem 1.2rem; border-radius: .8rem; background: #eaf4ff; color: #15385f; }
.org-flow { border-radius: 1rem; padding: 1.25rem; background: #f7fbff; border: 1px solid #dceafa; }
.org-row { display: flex; justify-content: center; }
.org-node { text-align: center; border: 1px solid #cfe1f7; border-radius: .8rem; padding: .85rem 1rem; background: #fff; min-width: 210px; box-shadow: 0 4px 12px rgba(31,78,121,.04); }
.org-node small { display: block; color: #6a7585; margin-top: .2rem; }
.org-primary { background: #eaf4ff; border-color: #9fc8f7; }
.org-architect { background: #0a58ca; border-color: #0a58ca; color: #fff; max-width: 650px; width: 70%; }
.org-architect small { color: rgba(255,255,255,.8); }
.org-production { background: #e9f8f0; border-color: #b8e4cc; }
.flow-arrow { text-align: center; color: var(--boot-blue-700); font-size: 1.35rem; font-weight: 800; line-height: 1.5; }
.org-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: .75rem; }
.org-grid-four { grid-template-columns: repeat(4,1fr); }
.lesson-table thead th { color: #164b87; background: #eef6ff; border-bottom-width: 1px; }
.lesson-table td, .lesson-table th { padding: .85rem; }
.timeline-list { position: relative; }
.timeline-item, .lab-step { display: flex; gap: 1rem; padding: 0 0 1.25rem; }
.timeline-item p, .lab-step p { color: #667285; margin: .25rem 0 0; }
.reference-flow { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .55rem; padding: 1rem; border-radius: .9rem; background: #f7fbff; border: 1px solid #dbe9fb; }
.reference-flow div { padding: .65rem .85rem; border-radius: .6rem; background: #fff; border: 1px solid #cfe1f7; font-weight: 700; font-size: .88rem; }
.reference-flow b { color: var(--boot-blue-700); }
.security-flow { background: #f3f8ff; }
.day-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: .75rem; }
.day-grid > div { border: 1px solid #dbe9fb; border-radius: .8rem; padding: .9rem; background: #fbfdff; }
.day-grid time { display: block; color: var(--boot-blue-700); font-weight: 800; font-size: .78rem; }
.day-grid strong, .day-grid small { display: block; }
.day-grid small { color: #6b7686; margin-top: .2rem; }
.lab-deliverable { border-radius: .8rem; padding: 1rem 1.2rem; border: 1px dashed #7eb5f4; background: #f4f9ff; }
.lesson-accordion .accordion-item { border-color: #dbe9fb; }
.lesson-accordion .accordion-button { font-weight: 700; }
.myth-card { height: 100%; border: 1px solid #f0d7d7; border-radius: .9rem; padding: 1rem; background: #fffafa; }
.myth { display: inline-block; font-size: .68rem; font-weight: 800; letter-spacing: .08em; color: #a33; margin-bottom: .4rem; }
.lesson-recap { border-radius: 1rem; color: #fff; background: linear-gradient(120deg, #052c65, #0a58ca); }
.recap-item { display: flex; gap: .8rem; align-items: flex-start; height: 100%; padding: .9rem; border-radius: .8rem; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.14); }
.recap-item > span { width: 1.8rem; height: 1.8rem; flex: 0 0 1.8rem; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; background: #fff; color: #0a58ca; font-weight: 800; }
.recap-item small { color: rgba(255,255,255,.78); }
.career-path { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; }
.career-path span { border-radius: 999px; padding: .65rem .9rem; background: var(--boot-blue-050); border: 1px solid #cfe1f7; font-weight: 700; font-size: .88rem; }
.career-path b { color: var(--boot-blue-700); }
.lesson-complete { border-top: 4px solid var(--boot-blue-600); }
.lesson-toc .nav-link { color: #566579; border-left: 2px solid #e2ebf5; padding: .38rem .7rem; }
.lesson-toc .nav-link:hover { color: var(--boot-blue-700); border-left-color: var(--boot-blue-600); background: #f5f9ff; }

@media (max-width: 991.98px) {
    .org-grid, .org-grid-four { grid-template-columns: 1fr 1fr; }
    .org-architect { width: 100%; }
    .day-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 575.98px) {
    .org-grid, .org-grid-four, .day-grid { grid-template-columns: 1fr; }
    .reference-flow { align-items: stretch; flex-direction: column; text-align: center; }
    .reference-flow b { transform: rotate(90deg); }
}
